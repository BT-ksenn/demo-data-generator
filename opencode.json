{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": ["skills"]
  },
  "permission": {
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "rm -rf *": "ask",
      "git push*": "ask",
      "git reset --hard*": "ask",
      "git clean*": "ask",
      "docker compose * down*": "ask",
      "docker compose * rm*": "ask",
      "docker volume rm*": "ask",
      "docker system prune*": "ask"
    },
    "external_directory": {
      "*": "ask",
      "~/Documents/1-projects/braintec/odoodemo-local-20/**": "allow",
      "../odoodemo-local-20/**": "allow",
      "~/.docker/**": "allow",
      "/private/var/folders/**": "allow",
      "/var/folders/**": "allow"
    },
    "doom_loop": "allow"
  }
}
